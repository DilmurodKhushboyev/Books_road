# ======= Books Road — muhit o'zgaruvchilari (Railway -> Variables) =======
# Bu faylni nusxalab .env qiling. Haqiqiy kalitlarni HECH QACHON Git'ga yozmang.

# --- Majburiy ---
BOT_TOKEN=                      # @BotFather bergan token
ADMIN_TELEGRAM_IDS=             # Do'kon egalari, vergul bilan: 11111,22222

# --- Baza (Railway Postgres avtomatik beradi) ---
DATABASE_URL=sqlite+aiosqlite:///./books_road.db

# --- AI (bepul: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- WebApp / server ---
PORT=8000
WEBAPP_URL=                     # https://<sizning-domen>.up.railway.app (bo'sh bo'lsa RAILWAY_PUBLIC_DOMAIN olinadi)
WEBHOOK_SECRET=                 # bo'sh bo'lsa polling rejimi ishlaydi
LOG_LEVEL=INFO
